    "@testing-library/user-event": "14.6.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "msw": "2.10.4",
    "openapi-typescript": "7.9.1",
    "pixelmatch": "7.1.0",
